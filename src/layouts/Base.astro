---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
// import WhatsApp from '../components/WhatsApp.astro'; // Disabled - pending chat solution
// Self-hosted fonts and icons (no third-party requests before cookie consent)
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/mulish/latin-500.css';
import '../styles/icons.css';
import '../styles/global.css';
import { getAlternateUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  locale?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'CellPowerX Wellness Center - Lisbon\'s pioneering frequency-based wellness center founded by Nuno Nina in 2005. Formerly Integrative Medicine Lda.',
  locale = 'en',
  canonicalUrl,
  ogImage = '/images/og-image.jpg',
  noindex = false,
} = Astro.props;

const siteBase = 'https://wellness.cellpowerx.com';
const canonical = canonicalUrl ?? (siteBase + Astro.url.pathname);
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : siteBase + ogImage;
const hreflangEn = getAlternateUrl(Astro.url.pathname, 'en', siteBase);
const hreflangPt = getAlternateUrl(Astro.url.pathname, 'pt', siteBase);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | CellPowerX Wellness Center</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}

  <!-- Canonical & hreflang -->
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={hreflangEn} />
  <link rel="alternate" hreflang="pt" href={hreflangPt} />
  <link rel="alternate" hreflang="x-default" href={hreflangEn} />

  <slot name="head" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | CellPowerX Wellness Center`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_US'} />
  <meta property="og:site_name" content="CellPowerX Wellness Center" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | CellPowerX Wellness Center`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  <!-- Schema.org: LocalBusiness + Person (Nuno Nina) -->
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "HealthAndBeautyBusiness",
      "@id": "https://wellness.cellpowerx.com/#business",
      "name": "CellPowerX Wellness Center",
      "alternateName": ["Integrative Medicine", "Integrative Medicine Lda", "IM Integrative Medicine"],
      "url": "https://wellness.cellpowerx.com",
      "logo": "https://wellness.cellpowerx.com/CPX_WellnessCenter_hor.svg",
      "image": ogImageAbsolute,
      "description": locale === 'pt'
        ? "Centro de bem-estar pioneiro em Lisboa dedicado a abordagens bioeléctricas e baseadas em frequências, fundado por Nuno Nina em 2005. Anteriormente conhecido como Integrative Medicine Lda."
        : "Lisbon's pioneering wellness center founded by Nuno Nina in 2005, dedicated to bioelectrical and frequency-based approaches to well-being. Formerly known as Integrative Medicine Lda.",
      "telephone": "+351211929218",
      "email": "geral@int-medicine.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Fontes Pereira de Melo, 21, 8º",
        "addressLocality": "Lisbon",
        "postalCode": "1050-116",
        "addressCountry": "PT"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 38.7297,
        "longitude": -9.1476
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
          "opens": "09:30",
          "closes": "18:30"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Friday",
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "founder": {
        "@type": "Person",
        "@id": "https://wellness.cellpowerx.com/#nuno-nina",
        "name": "Nuno Nina"
      },
      "foundingDate": "2005",
      "priceRange": "$$",
      "sameAs": [
        "https://www.cellpowerx.com",
        "https://www.int-medicine.com",
        "https://www.instagram.com/cellpowerx/",
        "https://www.facebook.com/ImIntegrativeMedicine/",
        "https://www.youtube.com/user/IMclinic/videos",
        "https://pt.linkedin.com/company/im-integrative-medicine"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://wellness.cellpowerx.com/#nuno-nina",
      "name": "Nuno Nina",
      "jobTitle": locale === 'pt' ? "Fundador e Director Científico" : "Founder & Scientific Director",
      "worksFor": {
        "@type": "Organization",
        "@id": "https://wellness.cellpowerx.com/#business"
      },
      "url": "https://wellness.cellpowerx.com",
      "sameAs": [
        "https://www.cellpowerx.com",
        "https://www.int-medicine.com"
      ]
    }
  ])} />
</head>
<body>
  <a href="#main" class="skip-link">{locale === 'pt' ? 'Saltar para o conteúdo' : 'Skip to content'}</a>
  <Nav locale={locale} />

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <Footer locale={locale} />
  <!-- <WhatsApp locale={locale} /> -->

  <CookieBanner locale={locale} />

  <!-- GSAP animations (client-side module) -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Respect users who ask for less motion - content stays visible, counters show final values
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Reveal animations
      const reveals = document.querySelectorAll('.reveal');
      reveals.forEach((el) => {
        gsap.fromTo(el,
          { opacity: 0, y: 24 },
          {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 85%',
              once: true,
            },
          }
        );
      });

      // Stagger groups
      const staggerGroups = document.querySelectorAll('[data-stagger]');
      staggerGroups.forEach((group) => {
        const children = group.children;
        gsap.fromTo(children,
          { opacity: 0, y: 24 },
          {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: 'power2.out',
            stagger: 0.12,
            scrollTrigger: {
              trigger: group,
              start: 'top 85%',
              once: true,
            },
          }
        );
      });

      // Counter animation for stats
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      counters.forEach((el) => {
        const target = el.getAttribute('data-counter');
        if (!target) return;
        const isNumber = /^\d+$/.test(target.replace(/[+,\.]/g, ''));
        if (!isNumber) return;

        const numericTarget = parseInt(target.replace(/[^0-9]/g, ''));
        const suffix = target.replace(/[0-9]/g, '');

        ScrollTrigger.create({
          trigger: el,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            const obj = { val: 0 };
            gsap.to(obj, {
              val: numericTarget,
              duration: 2,
              ease: 'power2.out',
              onUpdate: () => {
                const formatted = Math.round(obj.val).toLocaleString('en');
                // PT uses '.' as thousands separator (70.000)
                el.textContent = (document.documentElement.lang === 'pt' ? formatted.replace(/,/g, '.') : formatted) + suffix;
              },
            });
          },
        });
      });
    }
  </script>
</body>
</html>
